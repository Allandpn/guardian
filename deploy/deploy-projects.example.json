{
  "guardian": {
    "repo": "https://github.com/Allandpn/guardian.git",
    "tag_prefix": "release/",
    "workdir": "/opt/guardian",
    "sensitive": [
      "src/guardian/protocol/*",
      "src/guardian/executor/*",
      "src/guardian/deployer/*",
      "src/guardian/gateway/server.py",
      "src/guardian/gateway/db.py",
      "src/guardian/gateway/limits.py",
      "deploy/*",
      "tests/gwharness.py"
    ],
    "steps": [
      [
        "docker",
        "compose",
        "--env-file",
        "deploy/gateway.env",
        "-f",
        "deploy/docker-compose.yml",
        "up",
        "-d",
        "--build",
        "gateway"
      ],
      [
        "systemctl",
        "restart",
        "guardian-executor"
      ]
    ],
    "health": [
      [
        "docker",
        "exec",
        "deploy-gateway-1",
        "python",
        "-c",
        "import urllib.request as u; u.urlopen('http://127.0.0.1:8080/healthz', timeout=5)"
      ],
      [
        "systemctl",
        "is-active",
        "--quiet",
        "guardian-executor"
      ],
      [
        "docker",
        "exec",
        "deploy-gateway-1",
        "python",
        "-c",
        "import sqlite3,sys; d=sqlite3.connect('/data/gateway.db'); sys.exit(0 if d.execute(\"select 1 from devices where kind='executor' and report_ts>strftime('%s','now')-120\").fetchone() else 1)"
      ]
    ],
    "health_timeout_s": 180
  },
  "estudos": {
    "repo": "https://github.com/Allandpn/SGE-Concursos.git",
    "tag_prefix": "release/",
    "type": "compose",
    "workdir": "/opt/estudos",
    "allowed_binds": [
      "/mnt/ssd",
      "/var/log/estudos"
    ],
    "allowed_contexts": [
      "/opt/Plano-de-Estudos-Automatizado"
    ],
    "sensitive": [
      "docker-compose*.yml",
      "Dockerfile",
      "*.env",
      ".env*",
      "deploy/*"
    ],
    "steps": [
      [
        "docker",
        "compose",
        "up",
        "-d",
        "--build"
      ]
    ],
    "health": [
      [
        "sh",
        "-c",
        "[ \"$(docker inspect -f '{{.State.Health.Status}}' estudos-app-1)\" = healthy ]"
      ]
    ],
    "health_timeout_s": 300
  },
  "imagineer": {
    "repo": "https://github.com/Allandpn/Imagineer.git",
    "tag_prefix": "release/",
    "type": "compose",
    "workdir": "/home/allan/Imagineer",
    "allowed_binds": [
      "/home/allan/Imagineer"
    ],
    "sensitive": [
      "docker-compose*.yml",
      "Dockerfile",
      "*.env",
      ".env*"
    ],
    "steps": [
      [
        "docker",
        "compose",
        "up",
        "-d",
        "--build"
      ]
    ],
    "health": [
      [
        "sh",
        "-c",
        "[ \"$(docker inspect -f '{{.State.Running}}' imagineer-api-1)\" = true ]"
      ]
    ],
    "health_timeout_s": 180
  },
  "plano-de-estudos": {
    "repo": "https://github.com/Allandpn/Plano-de-Estudos-Automatizado.git",
    "tag_prefix": "release/",
    "workdir": "/opt/Plano-de-Estudos-Automatizado",
    "sensitive": [
      "Dockerfile",
      ".env*"
    ],
    "steps": [],
    "health": []
  }
}
