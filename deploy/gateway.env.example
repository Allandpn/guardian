# Copie para deploy/gateway.env (não versionado) e preencha.
TS_AUTHKEY=tskey-auth-...        # gere em admin console > Settings > Keys: reutilizável=não, efêmera=sim, pré-autorizada=sim, tag:gateway
TS_HOSTNAME=guardian-gw
GATEWAY_ORIGIN=https://guardian-gw.SUA-TAILNET.ts.net

# Opcional: análise por IA das instalações do Windows que falham (docs/AGENTE.md). Sem a chave, fica desligada.
# OPENROUTER_API_KEY=sk-or-...          # crie em openrouter.ai > Keys, com limite de gasto; coloque aqui, direto no Pi
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5   # confira o nome do modelo no OpenRouter
# AI_DAILY_MAX=30
