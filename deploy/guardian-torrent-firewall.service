[Unit]
Description=Guardian: tráfego do exit node passa pelo Suricata (bloqueio de torrent)
After=docker.service tailscaled.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Fora da pasta de deploy: o que roda como root no boot não muda com uma versão nova (deploy/install-deployer.sh copia, como root).
ExecStartPre=/usr/bin/docker compose -f /usr/local/lib/guardian-root/suricata/docker-compose.yml up -d
ExecStart=/usr/local/lib/guardian-root/torrent-firewall.sh

[Install]
WantedBy=multi-user.target
