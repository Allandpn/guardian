# Copie para /etc/guardian-executor.env (modo 0600, dono root) e preencha.
PIHOLE_URL=http://127.0.0.1:8081
# Senha de aplicativo do Pi-hole v6 (Settings > Web interface / API > Configure app password), em arquivo 0600 legível só pelo guardian-exec:
PIHOLE_PASSWORD_FILE=/etc/guardian-executor.pihole
# Domínio-canário do NotToday: o executor se recusa a alterá-lo.
CANARY=canario.exemplo.com
# Aparelhos protegidos: o executor aprende sozinho o IP na Tailscale de cada aparelho (o app o informa no relatório assinado).
# CLIENTS só é necessário para um aparelho com app antigo (sem "tsIps") e tem prioridade sobre o aprendido: IP (v4 e v6) = id do aparelho (site, em Avançado).
# CLIENTS=100.64.0.7=ABCDEFGHIJKLMNOPQRST,fd7a:115c:a1e0::7=ABCDEFGHIJKLMNOPQRST
